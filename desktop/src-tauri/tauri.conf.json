{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ctxward",
  "version": "0.2.0",
  "identifier": "dev.ctxward.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Ctxward",
        "width": 880,
        "height": 600,
        "resizable": true
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "tooltip": "Ctxward — LLM privacy gateway"
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
