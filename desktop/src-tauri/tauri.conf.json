{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ctxward",
  "version": "0.3.0-rc.1",
  "identifier": "dev.ctxward.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Ctxward",
        "width": 880,
        "height": 600,
        "resizable": true
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "tooltip": "Ctxward \u2014 LLM privacy gateway"
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Transparent LLM-privacy gateway",
    "longDescription": "Ctxward sits between your apps and the LLM providers they call, detecting and redacting PII, secrets and internal identifiers from prompts before they leave your machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
